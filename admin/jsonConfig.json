{
	"i18n": true,
	"type": "panel",
	"items": {
		"_intro": {
			"type": "staticText",
			"text": "MeshCore admin intro",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_alpha": {
			"type": "staticText",
			"text": "MeshCore admin alpha warning",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_repoLink": {
			"type": "staticLink",
			"label": "Open GitHub help and issues",
			"href": "https://github.com/goerdy/ioBroker.meshcore",
			"target": "_blank",
			"button": true,
			"variant": "outlined",
			"color": "primary",
			"icon": "help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"_serialHint": {
			"type": "staticText",
			"text": "Serial permission hint",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"serialPort": {
			"type": "selectSendTo",
			"label": "Serial device",
			"help": "Serial device help",
			"newLine": true,
			"command": "listSerialPorts",
			"manual": true,
			"showAllValues": true,
			"xs": 12,
			"sm": 12,
			"md": 8,
			"lg": 6,
			"xl": 6
		},
		"monitorPublicChannel": {
			"type": "checkbox",
			"label": "Store public channel messages",
			"help": "Store public channel messages help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"subscribedChannels": {
			"type": "text",
			"label": "Additional channel subscriptions",
			"help": "Additional channel subscriptions help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 8,
			"lg": 6,
			"xl": 6
		},
		"syncTimeOnConnect": {
			"type": "checkbox",
			"label": "Sync device time on connect",
			"help": "Sync device time on connect help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"messagePollIntervalSeconds": {
			"type": "number",
			"label": "Fallback message poll interval in seconds",
			"help": "Fallback message poll interval in seconds help",
			"min": 0,
			"step": 1,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 3
		},
		"statsRefreshMinutes": {
			"type": "number",
			"label": "Metadata refresh interval in minutes",
			"help": "Metadata refresh interval in minutes help",
			"min": 0,
			"step": 1,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 3
		},
		"reconnectDelaySeconds": {
			"type": "number",
			"label": "Reconnect delay in seconds",
			"help": "Reconnect delay in seconds help",
			"min": 5,
			"step": 1,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 3
		},
		"maxHistoryEntries": {
			"type": "number",
			"label": "Stored messages per branch",
			"help": "Stored messages per branch help",
			"min": 1,
			"step": 1,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 3
		},
		"_overviewHeader": {
			"type": "staticText",
			"text": "Overview section intro",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_overviewText": {
			"type": "textSendTo",
			"label": "Device overview",
			"container": "html",
			"command": "getOverviewText",
			"defaultSendTo": "getOverviewText",
			"button": "Refresh overview",
			"help": "Device overview help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_overviewQr": {
			"type": "imageSendTo",
			"label": "Contact QR code",
			"command": "getOverviewQrImage",
			"help": "Contact QR code help",
			"newLine": true,
			"width": 320,
			"height": 320,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"_channelHeader": {
			"type": "staticText",
			"text": "Channel management intro",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_channelList": {
			"type": "textSendTo",
			"label": "Known channels on device",
			"container": "html",
			"command": "getChannelListText",
			"defaultSendTo": "getChannelListText",
			"button": "Refresh channel list",
			"help": "Known channels on device help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_channelCreateIndex": {
			"type": "number",
			"label": "Channel index for create or update",
			"help": "Channel index for create or update help",
			"min": 1,
			"step": 1,
			"doNotSave": true,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 4,
			"lg": 3,
			"xl": 3
		},
		"_channelCreateName": {
			"type": "text",
			"label": "Channel name for create or update",
			"help": "Channel name for create or update help",
			"doNotSave": true,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 8,
			"lg": 5,
			"xl": 5
		},
		"_channelCreateSecret": {
			"type": "text",
			"label": "Channel secret for create or update",
			"help": "Channel secret for create or update help",
			"doNotSave": true,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 8,
			"lg": 6,
			"xl": 6
		},
		"_channelSave": {
			"type": "sendTo",
			"label": "Save channel to device",
			"command": "upsertChannel",
			"jsonData": "{\"channelIdx\": ${data._channelCreateIndex}, \"name\": \"${data._channelCreateName}\", \"secretHex\": \"${data._channelCreateSecret}\"}",
			"help": "Save channel to device help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 4,
			"lg": 3,
			"xl": 3
		}
	}
}
